[Unit]
Description=TCSO private membership intake
After=network.target

[Service]
Type=simple
User=tcso-intake
Group=tcso-intake
WorkingDirectory=/opt/tcso-intake
EnvironmentFile=-/etc/tcso-intake.env
ExecStart=/usr/bin/python3 /opt/tcso-intake/intake.py
Restart=on-failure
StateDirectory=tcso-intake
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_UNIX
MemoryMax=128M
TasksMax=32

[Install]
WantedBy=multi-user.target
